# Copy to .env and adjust. .env is gitignored — never commit real secrets.
#
#   cp .env.example .env
#
# The compose files set what the containers need, so .env is mostly for running
# outside Docker and for local overrides. Every setting has a working default;
# see backend/src/myapp/config/settings.py for the full list.

# ── core ─────────────────────────────────────────────────────────────────────
MYAPP_ENVIRONMENT=local          # local | dev | staging | prod
MYAPP_LOG_LEVEL=INFO
MYAPP_LOG_JSON=false             # true in deployed environments (one JSON object per line)

# ── database ─────────────────────────────────────────────────────────────────
# Default is a SQLite file, so the app runs with nothing else started.
# The compose stacks override this with Postgres.
MYAPP_DATABASE_URL=sqlite+aiosqlite:///./local.db
# MYAPP_DATABASE_URL=postgresql+asyncpg://myapp:myapp@localhost:55432/myapp
MYAPP_DB_ECHO=false

# ── host ports ───────────────────────────────────────────────────────────────
# Change these when you run more than one of these apps at once — the defaults
# collide. Only the *host* side moves; nothing inside the stack is affected.
MYAPP_WEB_HOST_PORT=5173         # Vite dev server
MYAPP_API_HOST_PORT=8000         # FastAPI (dev), and the whole app in prod
MYAPP_APP_HOST_PORT=8000         # docker-compose.prod.yml
MYAPP_DEBUG_HOST_PORT=5678       # debugpy
MYAPP_DB_HOST_PORT=55432         # Postgres — already non-default to avoid a local one
MYAPP_LOCALSTACK_HOST_PORT=4566

# ── object storage ───────────────────────────────────────────────────────────
# Empty bucket = in-memory storage (uploads vanish on restart — fine locally,
# a bug in production). `make up-aws` sets these to LocalStack automatically.
MYAPP_S3_BUCKET=
MYAPP_S3_ENDPOINT_URL=           # only for LocalStack/MinIO; empty for real AWS S3
MYAPP_S3_ACCESS_KEY=             # empty in AWS: the instance role is used instead
MYAPP_S3_SECRET_KEY=
MYAPP_S3_REGION=us-east-1

# ── sign-in ──────────────────────────────────────────────────────────────────
# Google is on when the client id is set. In Google Cloud console, create an
# OAuth client (Web application) and add this redirect URI:
#   <MYAPP_PUBLIC_URL>/api/v1/auth/google/callback
MYAPP_GOOGLE_CLIENT_ID=
MYAPP_GOOGLE_CLIENT_SECRET=
MYAPP_AUTH_DEV_LOGIN=true        # "sign in as the dev user" button; refused in staging/prod
MYAPP_ALLOWED_EMAIL_DOMAINS=[]   # e.g. ["example.com"]; empty = any Google account
MYAPP_PUBLIC_URL=http://localhost:5173   # the browser's origin; in prod your real URL
MYAPP_SESSION_SECRET=dev-session-secret  # prod: a long random string
MYAPP_COOKIE_SECURE=false        # true behind HTTPS

# ── production only ──────────────────────────────────────────────────────────
# Where the built SPA lives. Set in the production image; leave empty in dev,
# where Vite serves the frontend instead.
# MYAPP_FRONTEND_DIR=/app/frontend

# Postgres password for docker-compose.prod.yml.
# POSTGRES_PASSWORD=
